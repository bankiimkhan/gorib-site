{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorib-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "gorib.lol",
    "NEXT_PUBLIC_SITE_URL": "https://gorib.lol",
    "TMDB_BASE_URL": "https://api.themoviedb.org/3",
    "TMDB_IMAGE_BASE_URL": "https://image.tmdb.org/t/p",
    "STREAMING_PROVIDER": "mock",
    "NEXT_PUBLIC_ADS_ENABLED": "true",
    "NEXT_PUBLIC_AD_SLOTS_ENABLED": "true",
    "NEXT_PUBLIC_AD_PROVIDER": "custom",
    "NEXT_PUBLIC_CUSTOM_AD_SCRIPT_URL": "https://unfoldedtrade.com/b/XbV-s.dwG/l-0wYfWbcx/oe/mj9JuUZlUfl/kNPCTEcv0LN/TFQi0SO/DoU/tTNPzoQm1aN/DyQf4hODQL",
    "NEXT_PUBLIC_CUSTOM_AD_PLAYER_SAFE": "false",
    "NEXT_PUBLIC_AD_HOME_TOP": "true",
    "NEXT_PUBLIC_AD_HOME_FEED": "true",
    "NEXT_PUBLIC_AD_DETAILS_MID": "true",
    "NEXT_PUBLIC_AD_PLAYER_BOTTOM": "true",
    "NEXT_PUBLIC_AD_CATALOG_HEADER": "true",
    "NEXT_PUBLIC_AD_CATALOG_IN_FEED": "true",
    "NEXT_PUBLIC_AD_SEARCH": "true",
    "NEXT_PUBLIC_AD_LIVE_TV": "false",
    "NEXT_PUBLIC_AD_MOBILE_STICKY": "true",
    "TMDB_API_KEY": "63bcc17f6066180c0dc10bbded74c140",
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  }
}

