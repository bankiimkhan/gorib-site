# ==========================================
# GORIB.LOL STREAMING PLATFORM CONFIGURATION
# ==========================================

# TMDB Configuration (Metadata Provider)
# Get a key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Streaming Provider Configuration
# Supported providers: mock | custom | vidsrc | embed
STREAMING_PROVIDER=mock
STREAMING_API_KEY=
STREAMING_BASE_URL=

# Optional Stremio HTTP addons (comma-separated manifest URLs). Only web-ready
# direct http(s) streams are shown; torrent and header-dependent streams are skipped.
STREMIO_ADDONS=

# Application Settings
NEXT_PUBLIC_SITE_NAME=gorib.lol
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private owner-only analytics access. Generate a long random value; never use
# a NEXT_PUBLIC_ variable and never commit the real value.
ANALYTICS_ADMIN_TOKEN=

# ==========================================
# PROGRAMMATIC & DISPLAY AD CONFIGURATION
# ==========================================
# Master Toggle: Set to true to activate advertising slots across the platform
NEXT_PUBLIC_ADS_ENABLED=true
NEXT_PUBLIC_AD_SLOTS_ENABLED=true

# Active Provider: placeholder | custom
# - placeholder: Development & staging inspection mode with exact bounding boxes
# - custom: HilltopAds display tag only
NEXT_PUBLIC_AD_PROVIDER=placeholder

# Placeholder Style: debug (displays dimensions and slot metadata) | sponsor | minimal
NEXT_PUBLIC_AD_PLACEHOLDER_MODE=debug

# Sustainable default: one discovery unit per view, only in high-intent content contexts.
NEXT_PUBLIC_AD_HOME_TOP=true
NEXT_PUBLIC_AD_HOME_FEED=false
NEXT_PUBLIC_AD_DETAILS_MID=true
NEXT_PUBLIC_AD_PLAYER_BOTTOM=false

# Frequency / UX guardrails. Raise only through a documented experiment.
NEXT_PUBLIC_AD_MAX_REQUESTS_PER_PAGE=1
NEXT_PUBLIC_AD_MAX_REQUESTS_PER_SESSION=4
# Fixed mobile banners are opt-in and must remain dismissible.
NEXT_PUBLIC_AD_ALLOW_MOBILE_STICKY=false

# Catalog, search, and in-feed placements
NEXT_PUBLIC_AD_CATALOG_HEADER=true
NEXT_PUBLIC_AD_CATALOG_IN_FEED=true
NEXT_PUBLIC_AD_SEARCH=true
NEXT_PUBLIC_AD_LIVE_TV=false
NEXT_PUBLIC_AD_MOBILE_STICKY=false

# HilltopAds programmatic display tag
# Multitags often bundle popunders and invisible click overlays placed over iframes.
# They are NEVER loaded on player pages (/watch, /live-tv) unless you declare the
# script a pure banner tag with NEXT_PUBLIC_CUSTOM_AD_PLAYER_SAFE=true. Leave it
# false unless you have verified the tag cannot overlay, redirect, or pop on click.
NEXT_PUBLIC_CUSTOM_AD_PLAYER_SAFE=false
# Leave false until the provider's exact tag and creatives are audited as
# display-only (no pop-ups, pop-unders, redirects, click overlays, or autoplay).
NEXT_PUBLIC_CUSTOM_AD_DISPLAY_ONLY_APPROVED=false
NEXT_PUBLIC_CUSTOM_AD_SCRIPT_URL=https://unfoldedtrade.com/b/XbV-s.dwG/l-0wYfWbcx/oe/mj9JuUZlUfl/kNPCTEcv0LN/TFQi0SO/DoU/tTNPzoQm1aN/DyQf4hODQL
NEXT_PUBLIC_AD_DEBUG=false
